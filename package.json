{
  "name": "@harness-lens/cli",
  "version": "0.0.6",
  "description": "Command-line interface for deterministic Harness Lens analysis.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "harness-lens": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "distribution:test": "node --test test/distribution.test.mjs",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harness-lens/cli.git"
  },
  "homepage": "https://github.com/harness-lens/cli#readme",
  "bugs": {
    "url": "https://github.com/harness-lens/cli/issues"
  },
  "keywords": [
    "agents",
    "harness",
    "cli",
    "validation"
  ],
  "author": "Cristian Camargo Filho",
  "license": "MPL-2.0",
  "dependencies": {
    "@harness-lens/core": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  }
}
